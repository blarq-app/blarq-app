# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
*.db
*.db-journal

# certificados digitales (SII Chile) — NUNCA commitear
*.pfx
*.pfx.old
*.p12
sii-cert/
cert/

# claude sessions
.claude/

# backups locales de la BD (script db:backup) — datos sensibles, NO commitear
/backups/

# respaldos y exports locales de scripts de conciliación (datos financieros) — NO commitear
*-backup.json
audit-tarjeta-sin-factura.csv
