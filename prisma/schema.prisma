generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USUARIOS ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("colaborador") // admin | colaborador
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== PROYECTOS ====================

model Project {
  id              String   @id @default(cuid())
  // Numeración correlativa: cada proyecto vive primero como cotización
  // (numeroCotizacion asignado al crear) y, si se aprueba, recibe un
  // numeroProyecto. Ambos son monotónicos y nunca se reusan.
  // Excepción: registros internos (BLARQ y centros de costo) tienen
  // ambos en null y se distinguen por isInternal.
  numeroCotizacion Int?    @unique
  numeroProyecto   Int?    @unique
  isInternal       Boolean @default(false)

  name            String
  clientName      String
  // RUT del cliente final (receptor del DTE cuando emitamos factura).
  // Se guarda normalizado sin puntos pero CON guión y DV mayúscula:
  // "12345678-9", "76123456-K". Validación de formato + DV chileno
  // (módulo 11) en `src/lib/clients/rut.ts`. Opcional por ahora porque
  // los proyectos existentes no tienen este dato — se completa cuando
  // MJ los va tocando, o como pre-requisito al emitir factura.
  clientRut       String?
  clientPhone     String?
  clientEmail     String?
  address         String?
  // cotizacion | ejecucion | terminado | archivado
  // (legacy "aprobado" → "ejecucion" en migración 2026-04-28)
  status          String   @default("cotizacion")
  startDate       DateTime?
  estimatedEndDate DateTime?
  actualEndDate   DateTime?
  currentVersion  String   @default("V1")
  ufReference     Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budgetVersions  BudgetVersion[]
  invoices        Invoice[]
  maestroId       String?
  maestro         Maestro?        @relation(fields: [maestroId], references: [id])
  estadosPago     EstadoPago[]
  shoppingItems   ShoppingItem[]
  invoiceRules    InvoiceCategorizationRule[]

  @@index([maestroId])
  @@index([status])
}

// ==================== MAESTROS (mano de obra) ====================

model Maestro {
  id            String   @id @default(cuid())
  name          String
  rut           String?
  phone         String?
  emitsInvoice  Boolean  @default(false) // ¿emite factura?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      Project[]
}

// ==================== ESTADOS DE PAGO ====================

model EstadoPago {
  id              String   @id @default(cuid())
  projectId       String
  budgetVersionId String?  // versión del presupuesto base de este EP (null si es legacy o todavía no asociado)
  number          Int      // correlativo por proyecto: 1, 2, 3...
  date            DateTime @default(now())
  status          String   @default("borrador") // borrador | cerrado
  closedAt        DateTime? // se setea cuando status pasa a cerrado
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetVersion   BudgetVersion?   @relation(fields: [budgetVersionId], references: [id])
  items           EstadoPagoItem[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([budgetVersionId])
}

model EstadoPagoItem {
  id                  String   @id @default(cuid())
  estadoPagoId        String
  obraItemId          String   // Apunta al ObraItem de la versión actual del presupuesto. Se refresca al sync.
  lineageId           String   @default(cuid()) // Identidad estable de la partida a través de versiones del presupuesto.
  // Snapshot al momento del EP (se actualiza al sync)
  chapter             String
  itemNumber          String
  name                String
  descriptionMaestro  String?  @map("description") // Snapshot de ObraItem.descriptionMaestro
  unit                String
  quantity            Float    // cantidad_total presupuestada (snapshot, refrescable al sync)
  laborUnitPrice      Float    // MO unitaria (snapshot, refrescable al sync)
  laborTotal          Float    // referencial = quantity × laborUnitPrice
  // Avance — la verdad financiera ahora vive aquí
  quantityExecuted    Float    @default(0) // cantidad ejecutada acumulada al final de ESTE EP
  // Snapshot inmutable que se setea al cerrar el EP
  amountPaid          Float?   // (quantityExecuted - prevExecuted) × laborUnitPrice al momento de cierre
  // Marcado por sync: partida que existía en la versión vieja del presupuesto pero no en la nueva
  outOfScope          Boolean  @default(false)
  // Legacy / derivado: lo dejamos por backward-compat pero ahora se calcula desde quantityExecuted
  pctAccumulated      Float    @default(0)
  sortOrder           Int      @default(0)

  estadoPago          EstadoPago @relation(fields: [estadoPagoId], references: [id], onDelete: Cascade)

  @@unique([estadoPagoId, obraItemId])
  @@unique([estadoPagoId, lineageId])
  @@index([estadoPagoId])
  @@index([obraItemId])
  @@index([lineageId])
}

// ==================== PRESUPUESTOS ====================

model BudgetVersion {
  id          String   @id @default(cuid())
  projectId   String
  version     String   // V1, V2, V3...
  parentVersionId String? // Versión origen cuando se duplica (V2.parentVersionId = V1.id). Null para versiones creadas desde cero.
  date        DateTime @default(now())
  status      String   @default("borrador") // borrador | enviado | aprobado | rechazado
  type        String   // obra | muebles | artefactos
  observations String?
  ggPercentage    Float?  @default(20)  // Solo para obra
  utilityPercentage Float? @default(5)  // Solo para obra
  // Descuento global aplicado al subtotal (decimal: 0.02 = 2%). Usado
  // típicamente en muebles cuando se cierra el deal. Aplica al subtotal
  // c/IVA y c/neto antes de mostrarlo como "total acordado".
  discountPercentage Float? @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentVersion BudgetVersion? @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions BudgetVersion[] @relation("VersionLineage")
  obraItems   ObraItem[]
  muebleChapters MuebleChapter[]
  muebleItems MuebleItem[]
  artefactoItems ArtefactoItem[]
  paymentTerms PaymentTerm[]
  estadosPago EstadoPago[]

  @@index([projectId])
  @@index([parentVersionId])
}

// Partidas de obra
model ObraItem {
  id                String  @id @default(cuid())
  budgetVersionId   String
  lineageId         String  @default(cuid()) // Identidad estable de la partida a través de versiones del presupuesto. Se preserva al duplicar la versión.
  chapter           String  // demoliciones, reparaciones, electricas, sanitarias, terminaciones, limpieza
  // Sub-chapter opcional dentro del chapter (ej: "COCINA", "BAÑO PRINCIPAL"
  // dentro de "INSTALACIONES SANITARIAS"). Solo se usa como separador visual
  // en el editor y PDF — no afecta cálculos. Null = sin sub-chapter.
  subChapter        String?
  itemNumber        String  // 1.1, 1.2, etc (legacy — el display usa correlativo recalculado)
  name              String
  descriptionCliente String? @map("description") // Va en el PDF del presupuesto
  descriptionMaestro String? // Va al estado de pago del maestro
  unit              String  // M2, ML, UN, GL
  quantity          Float
  unitPrice         Float
  total             Float
  // Desglose interno (no visible al cliente)
  costMaterial      Float?
  costLabor         Float?
  costSubcontract   Float?
  costMargin        Float?
  costTools         Float?
  costLoss          Float?
  sortOrder         Int     @default(0)
  catalogPartidaId  String?
  isCustomized      Boolean @default(false) // True si la partida fue editada respecto a su PartidaCatalog origen, o si fue creada manualmente sin catálogo. Habilita "refrescar precios desde catálogo" sin pisar customizaciones.

  budgetVersion     BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  components        ObraItemComponent[]

  @@index([budgetVersionId])
  @@index([catalogPartidaId])
  @@index([lineageId])
}

// Snapshot de los componentes de una partida AL MOMENTO de crearse el ObraItem
// (regla MJ 2026-05-05: una cotización aprobada debe ser inmutable ante
// cambios al catálogo). Cada ObraItem tiene su propia copia denormalizada
// de los componentes que se usan en la lista de compras y EPs. Si JT edita
// el catálogo después, los proyectos vivos NO se ven afectados.
//
// Schema replica PartidaComponent uno-a-uno para mantener compatibilidad
// con el editor existente. La diferencia: la FK apunta a ObraItem en lugar
// de PartidaCatalog.
model ObraItemComponent {
  id            String   @id @default(cuid())
  obraItemId    String
  type          String   // material | mano_obra | margen | herramientas | subcontrato | perdida
  description   String
  unit          String   // UN, M2, ML, %, GL, DIA
  quantity      Float    @default(0)
  unitCost      Float    @default(0)
  totalCost     Float    @default(0)
  referenceLink String?
  materialId    String?  // referencia al catálogo de materiales
  // Marca true cuando MJ edita este componente manualmente desde el editor
  // del presupuesto. El sync automático con MaterialCatalog respeta este
  // flag — no pisa componentes personalizados para ese proyecto.
  isCustomized  Boolean  @default(false)
  sortOrder     Int      @default(0)
  appliedToComponentId String?
  appliedToType        String?

  obraItem      ObraItem @relation(fields: [obraItemId], references: [id], onDelete: Cascade)
  material      MaterialCatalog? @relation(fields: [materialId], references: [id])

  @@index([obraItemId])
  @@index([materialId])
}

// Capítulos de muebles. Un proyecto puede tener varios:
// "MUEBLES DE COCINA", "CLOSET DORMITORIO", "WALK-IN", etc.
model MuebleChapter {
  id              String  @id @default(cuid())
  budgetVersionId String
  chapterNumber   Int     // 1, 2, 3 — para numeración (1 MUEBLES DE COCINA → items 1.1, 1.2)
  name            String  // "MUEBLES DE COCINA"
  sortOrder       Int     @default(0)

  budgetVersion   BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  items           MuebleItem[]

  @@index([budgetVersionId])
}

// Items dentro de un capítulo. Ej: 1.1 MUEBLES, 1.2 HERRAJES, 1.3 CUBIERTAS.
// Cada item tiene su propio cálculo de costo (proveedor, distribuidor, utilidad).
model MuebleItem {
  id                 String  @id @default(cuid())
  budgetVersionId    String  // Denormalizado para queries rápidas (mismo de chapter.budgetVersionId)
  chapterId          String
  itemNumber         String  // "1.1", "1.2", "1.3"
  name               String  // "MUEBLES", "HERRAJES", "CUBIERTAS"
  descriptionGeneral String? // "SEGÚN PLANOS ARQUITECTURA" — texto general bajo el nombre
  quantity           Float   @default(1)
  // Cálculo interno
  supplier           String?
  costDistributor    Float   @default(0) // Lo que paga BLARQ al proveedor
  utilityPercentage  Float   @default(0) // Margen como decimal: 0.36 = 36%
  clientPriceNet     Float   @default(0) // Neto al cliente = costDistributor × (1 + utility)
  clientPriceIva     Float   @default(0) // C/IVA al cliente = clientPriceNet × 1.19
  sortOrder          Int     @default(0)

  budgetVersion      BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  chapter            MuebleChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  details            MuebleDetail[]
  quotes             MuebleQuote[]

  @@index([budgetVersionId])
  @@index([chapterId])
}

// Cotizaciones alternativas para un MuebleItem. Una está marcada como
// `isSelected=true` (la activa) — sus valores se denormalizan en el item
// y son los que se muestran en el PDF al cliente y cuentan en totales.
// Las otras quedan como referencia para comparar precios entre proveedores.
model MuebleQuote {
  id                String  @id @default(cuid())
  itemId            String
  supplier          String?
  costDistributor   Float   @default(0)
  utilityPercentage Float   @default(0) // decimal: 0.36 = 36%
  clientPriceNet    Float   @default(0) // calculado: cost × (1 + util)
  clientPriceIva    Float   @default(0) // calculado: net × 1.19
  notes             String?
  isSelected        Boolean @default(false)
  sortOrder         Int     @default(0)

  item              MuebleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Detalle de componentes bajo un MuebleItem.
// Ej. para 1.1 MUEBLES: CUERPO INTERIOR / TRASERA / FRENTE BASE / FRENTE MURAL / ZOCALO,
// cada uno con su materialidad ("MELAMINA BLANCA 18MM, TAPACANTO PVC 0,4MM").
model MuebleDetail {
  id        String  @id @default(cuid())
  itemId    String
  name      String  // "CUERPO INTERIOR", "TRASERA"
  material  String  // "MELAMINA BLANCA 18MM, TAPACANTO PVC 0,4MM"
  sortOrder Int     @default(0)

  item      MuebleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Items de artefactos
model ArtefactoItem {
  id                String  @id @default(cuid())
  budgetVersionId   String
  room              String  // baño_principal, baño_secundario, cocina, etc
  subcategory       String  // sanitario | cocina | iluminacion
  name              String  // WC, GRIFERIA, etc
  detail            String? // Descripcion del producto
  brand             String?
  quantity          Int     @default(1)
  listPrice         Float   // Precio lista
  discountPercent   Float?  // % descuento al cliente
  clientPrice       Float   // Precio final al cliente
  // Interno (no visible al cliente)
  realCostBlarq     Float?  // Lo que realmente paga BLARQ
  referenceLink     String?
  sortOrder         Int     @default(0)

  budgetVersion     BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)

  @@index([budgetVersionId])
}

// Formas de pago por presupuesto
model PaymentTerm {
  id                String  @id @default(cuid())
  budgetVersionId   String
  stage             String  // anticipo | avance1 | avance2 | saldo
  percentage        Float
  amount            Float?  // Calculado
  sortOrder         Int     @default(0)

  budgetVersion     BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)

  @@index([budgetVersionId])
}

// ==================== CATALOGO DE PARTIDAS ====================

// Partida del catálogo global (reutilizable entre proyectos)
model PartidaCatalog {
  id                 String   @id @default(cuid())
  category           String   // OBRAS PRELIMINARES, DEMOLICIONES, etc
  name               String   // CIERRE OSB, DEMOLICION TABIQUE, etc
  descriptionCliente String?  @map("description") // Va en el PDF del cliente (se propaga a ObraItem)
  descriptionMaestro String?  // Va en el estado de pago del maestro (se propaga a ObraItem y EstadoPagoItem)
  sortOrder          Int      @default(0) // Orden manual dentro de la categoría
  unit               String   // M2, ML, UN, GL
  unitPrice          Float    @default(0) // Precio unitario de referencia
  // Desglose de costos
  costMaterial  Float    @default(0)
  costLabor     Float    @default(0)
  costTools     Float    @default(0)
  costMargin    Float    @default(0)
  costLoss      Float    @default(0)
  costSubcontract Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components    PartidaComponent[]

  @@unique([category, name])
  @@index([category])
}

// Componentes de una partida (materiales, mano de obra, etc.)
model PartidaComponent {
  id            String   @id @default(cuid())
  partidaId     String
  type          String   // material | mano_obra | margen | herramientas | subcontrato | perdida
  description   String   // SACO YESO 25KG, MAESTRO, etc
  unit          String   // UN, M2, ML, %, GL, DIA
  quantity      Float    @default(0)
  unitCost      Float    @default(0) // P. CONCEPTO NETO
  totalCost     Float    @default(0) // P.U NETO (qty * unitCost)
  referenceLink String?  // Link Sodimac, etc
  materialId    String?  // Referencia al catálogo de materiales
  sortOrder     Int      @default(0)
  // Para componentes con unit="%" — sobre qué se aplica el porcentaje:
  //   - margen: applied* todos null, total = % × suma del resto excepto pérdida.
  //   - perdida: appliedToComponentId apunta a un componente concreto (típica-
  //     mente un material) de la misma partida. total = % × totalCost de ese.
  //   - leyes (mano_obra con unit="%"): appliedToType = "mano_obra".
  //     total = % × suma de mano_obra (no-%) de la partida.
  appliedToComponentId String?
  appliedToType        String? // "mano_obra" | "material" | etc.

  partida       PartidaCatalog @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  material      MaterialCatalog? @relation(fields: [materialId], references: [id])

  @@index([partidaId])
  @@index([materialId])
}

// ==================== CATALOGO DE MATERIALES ====================

model MaterialCatalog {
  id            String   @id @default(cuid())
  category      String   // SACOS, FIJACIONES, PINTURAS, etc
  name          String   @unique // SACO YESO 25KG, etc
  unit          String   @default("UN")
  netPrice      Float    @default(0) // Precio neto actualizado
  isProvision   Boolean  @default(false) // Provisión al cliente (no es producto Sodimac)
  referenceLink String?  // Link Sodimac, etc
  lastUpdated   DateTime @default(now())
  lastResearchAt DateTime? // última vez que buscamos precios online
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components    PartidaComponent[]
  obraItemComponents ObraItemComponent[]
  shoppingItems ShoppingItem[]
  priceOffers   MaterialPriceOffer[]
}

// Ofertas de precio por tienda para un material
model MaterialPriceOffer {
  id           String   @id @default(cuid())
  materialId   String
  store        String   // sodimac | easy | construmart | mercadolibre | imperial | chilemat | otro
  productName  String   // nombre exacto en la tienda
  productUrl   String?
  price        Float    // precio (con IVA tal como aparece en la web)
  priceNet     Float?   // precio neto calculado (price / 1.19)
  available    Boolean  @default(true)
  isPinned     Boolean  @default(false) // elegido por el usuario como fuente oficial
  notes        String?
  checkedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material     MaterialCatalog @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([store])
}

// Historial de precios (snapshot cada vez que se refresca)
model MaterialPriceHistory {
  id         String   @id @default(cuid())
  materialId String
  store      String
  price      Float
  checkedAt  DateTime @default(now())

  @@index([materialId])
  @@index([checkedAt])
}

// ==================== LISTA DE COMPRA ====================

model ShoppingItem {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  unit        String   @default("UN")
  qtyNeeded   Float    @default(0)
  qtyBought   Float    @default(0)
  notes       String?
  materialId  String?
  manualAdd   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material    MaterialCatalog? @relation(fields: [materialId], references: [id])

  @@index([projectId])
  @@index([materialId])
}

// ==================== CATEGORIAS DE COSTO ====================

model CostCategory {
  id          String  @id @default(cuid())
  name        String
  parentId    String? // Para subcategorias
  type        String  @default("directo") // directo | indirecto
  // A qué tipo de factura aplica esta categoría:
  //   "recibida" = solo facturas que llegan a BLARQ (proveedores). Default.
  //                Acá vivien Materiales, MO, Herramientas, Subcontrato, etc.
  //   "emitida"  = solo facturas que emite BLARQ al cliente. Acá viven
  //                Obra, Muebles, Artefactos (top-level del cobro).
  //   "both"     = aplica a ambas (raro, dejado por completitud).
  appliesTo   String  @default("recibida")
  sortOrder   Int     @default(0)

  parent      CostCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children    CostCategory[] @relation("CategoryParent")
  invoices    Invoice[]
  invoiceRules InvoiceCategorizationRule[]

  @@index([parentId])
}

// ==================== FACTURAS ====================

model Invoice {
  id              String   @id @default(cuid())
  projectId       String?
  categoryId      String?
  type            String   // emitida | recibida
  // Identidad SII (DTE):
  // - tipoDoc: 33=factura electrónica, 34=factura exenta, 39=boleta,
  //   41=boleta exenta, 56=nota débito, 61=nota crédito.
  // - folioNumber, rutIssuer son los identificadores del DTE.
  // - rutReceiver: para facturas recibidas es BLARQ; para emitidas es el cliente.
  // El triple (tipoDoc, folioNumber, rutIssuer) más type es único — sirve para
  // el upsert idempotente del cron de sincronización SII.
  tipoDoc         Int?
  folioNumber     String?
  rutIssuer       String?
  rutReceiver     String?
  businessName    String?
  issueDate       DateTime
  dueDate         DateTime?
  netAmount       Float
  iva             Float
  totalAmount     Float
  status          String   @default("pendiente") // pendiente | pagada | anulada
  // Fecha en que la factura fue efectivamente pagada (set automáticamente
  // al conciliar con un movimiento bancario). null si todavía está pendiente.
  paidAt          DateTime?
  // conceptoCobro: solo aplica a facturas EMITIDAS. Indica qué tipo de
  // cobro es para el cálculo del fondo sueldos:
  //   - "obra"       → suma a "cobrado obra", aporta GG×pct al fondo
  //   - "muebles"    → suma a "cobrado muebles", aporta utilidad×pct al fondo
  //   - "artefactos" → suma a "cobrado artefactos", NO aporta al fondo
  //   - "mixto"      → MJ define el split en porcentajes (campo extra a futuro)
  // Para facturas recibidas, queda null (no aplica).
  conceptoCobro   String?
  // Referencia a otra factura cuando este DTE la modifica.
  // Solo aplica a NC (tipoDoc=61) y ND (tipoDoc=56), que en Chile siempre
  // referencian la factura original que cancelan/ajustan.
  // referenceFolioNumber + referenceTipoDoc (típicamente 33) identifican
  // ese DTE original. Si la factura original existe en la app, se puede
  // resolver el id por (type, tipoDoc=referenceTipoDoc, folioNumber=
  // referenceFolioNumber, rutIssuer del mismo emisor).
  referenceFolioNumber String?
  referenceTipoDoc     Int?
  // Compensación de NC (tipoDoc=61). Tres modos:
  //   "other_invoice": el proveedor aplica el crédito a OTRA factura
  //     (caso DP — comprás, devolvés, te compensan en la próxima compra).
  //     compensationType = "other_invoice" + appliedToInvoiceId = factura cubierta.
  //   "cash_refund": el proveedor devuelve la plata en efectivo
  //     (caso Sodimac). compensationType = "cash_refund" sin asociaciones.
  //   "bank_refund": el proveedor devuelve la plata a tu cuenta bancaria.
  //     compensationType = "bank_refund" + refundBankMovementId = ID del
  //     BankMovement entrante donde se acreditó la devolución.
  // En los tres casos la NC ya está "consumida" — no aparece como
  // pendiente ni genera ruido visual. La factura compensada (en el modo
  // other_invoice) queda cubierta por la suma de InvoicePayments + monto
  // de NCs aplicadas.
  compensationType        String?  // "other_invoice" | "cash_refund" | "bank_refund" | null
  appliedToInvoiceId      String?
  refundBankMovementId    String?
  origin          String   @default("manual") // manual | sii_automatica
  // Trazabilidad SII (cuando origin = sii_automatica)
  siiTrackId      String?  // Identificador del DTE en SII (track id que devuelve el proveedor)
  xmlUrl          String?  // URL al XML del DTE (cuando OpenFactura lo expone)
  pdfUrl          String?  // URL al PDF del DTE
  syncedAt        DateTime? // Última vez que se trajo/refrescó del SII
  // PDF oficial del SII cacheado en BD. Se baja vía sync local con cert digital
  // (scripts/sync-sii-pdfs.ts). siiCodigo es el ID interno del SII para el
  // endpoint mipeShowPdf.cgi (~10 dígitos, único por DTE).
  // pdfFetchedAt: null = nunca se intentó; con valor = se intentó (con o sin
  // éxito; si pdfContent es null entonces el DTE no aparece en mipeAdminDocsRcp).
  siiCodigo       String?
  pdfContent      Bytes?
  pdfFetchedAt    DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project?      @relation(fields: [projectId], references: [id])
  category        CostCategory? @relation(fields: [categoryId], references: [id])
  payments        InvoicePayment[]

  @@unique([type, tipoDoc, folioNumber, rutIssuer], name: "dte_unique")
  @@index([projectId])
  @@index([categoryId])
  @@index([origin, projectId]) // para query "SII sin asignar"
  @@index([siiTrackId])
  @@index([appliedToInvoiceId]) // para sumar NCs aplicadas a una factura
}

// Imputación de un movimiento bancario a una factura. Sirve para cobros
// parciales (varios movimientos contra una factura) y splits (un
// movimiento contra varias facturas — caso típico: cliente transfiere un
// monto único que cubre obra + muebles + artefactos en facturas separadas).
//
// Reglas:
//   - amountApplied es siempre positivo (CLP). El "sentido" lo da el tipo
//     de factura: emitida=cobro, recibida=pago.
//   - Σ(amountApplied where invoiceId=X) define el status de la factura:
//       0                    → pendiente
//       0 < sum < totalAmount → parcial
//       sum >= totalAmount   → pagada (paidAt = max(date) de los movs)
//   - Σ(amountApplied where bankMovementId=Y) ≤ |amount| del mov. El
//     resto del monto puede estar sin imputar (típico cuando el abono
//     incluye plata que no es de facturas — ej, pago al maestro JT).
// Regla de auto-categorización de movimientos bancarios. Cuando MJ
// categoriza un movimiento manualmente, se guarda una regla que matchea
// movimientos futuros con descripción similar y les aplica la misma
// categoría. Eso ahorra clicks repetidos en cada cartola que entra.
//
// La regla matchea por substring case-insensitive contra
// BankMovement.description. El patrón se deriva de las primeras palabras
// de la descripción al crear la regla; MJ puede editarlo después.
//
// Aplicación:
//   - En el import (después del auto-match contra facturas), se aplican
//     las reglas a movs que quedan sin_asignar.
//   - Cuando MJ categoriza manualmente, se actualiza/crea la regla en
//     paralelo al PATCH del movimiento.
// Regla de auto-categorización de facturas por proveedor.
// Cuando MJ asigna categoría a una factura recibida (manual o vía bulk),
// se crea/actualiza una regla "RUT proveedor → categoría". Próximas
// facturas que llegan con ese RUT (sync SII o creación manual) heredan
// la categoría automáticamente.
//
// El proyecto / centro de costo NUNCA se auto-asigna: depende del
// contexto temporal y MJ lo decide siempre a mano.
model InvoiceCategorizationRule {
  id           String   @id @default(cuid())
  rutIssuer    String   @unique // RUT del proveedor — único, una regla por proveedor
  businessName String?  // nombre referencial, se actualiza con la última factura vista
  // Acción de la regla. Al menos uno de los dos campos debe estar puesto:
  //   - categoryId: auto-asigna categoría al matchear el RUT
  //   - projectId: auto-asigna centro de costo (proyecto)
  // Si ambos están, la regla setea las 2 cosas en una pasada. Si solo
  // uno, ese campo se setea y el otro se respeta (no se sobreescribe).
  categoryId   String?
  projectId    String?
  hits         Int      @default(0) // cuántas facturas se categorizaron con esta regla
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     CostCategory? @relation(fields: [categoryId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  @@index([rutIssuer])
  @@index([categoryId])
  @@index([projectId])
}

model BankCategorizationRule {
  id                 String   @id @default(cuid())
  descriptionPattern String   // substring a buscar (case-insensitive)
  category           String   // sueldo | previred | comision_bancaria | etc
  hits               Int      @default(0) // cuántas veces se aplicó (señal de "regla útil")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([descriptionPattern, category])
}

model InvoicePayment {
  id              String       @id @default(cuid())
  bankMovementId  String
  invoiceId       String
  amountApplied   Float
  createdAt       DateTime     @default(now())

  bankMovement    BankMovement @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([bankMovementId, invoiceId], name: "payment_unique")
  @@index([invoiceId])
  @@index([bankMovementId])
}

// ==================== CUENTAS BANCARIAS Y MOVIMIENTOS ====================

// Las cuentas bancarias de BLARQ. Hoy son 2 (operativa y sueldos), pero
// el modelo soporta más (ahorro, dólares, etc).
model BankAccount {
  id            String   @id @default(cuid())
  // Número visible en cartola (ej: "0-000-8913459-5"). Único.
  accountNumber String   @unique
  // Nombre interno para mostrar (ej: "Operativa", "Sueldos").
  alias         String
  // role: operating (cta operativa) | salary_fund (fondo sueldos) | other.
  // Permite a la app aplicar reglas distintas — ej: el saldo de salary_fund
  // se muestra como "fondo disponible para sueldos" en el dashboard.
  role          String   @default("operating")
  bank          String   @default("Santander")
  currency      String   @default("CLP")
  // Último saldo conocido y la fecha a la que corresponde. Se actualiza
  // automáticamente al importar una cartola con fechaHasta posterior.
  // Es el dato oficial del banco — el "neto importado" sumando movimientos
  // no sirve si hay plata previa al primer import.
  lastKnownBalance     Float?
  lastKnownBalanceDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements     BankMovement[]
}

model BankMovement {
  id              String   @id @default(cuid())
  bankAccountId   String
  date            DateTime
  description     String   // descripción tal como viene en cartola
  amount          Float    // signed: negativo = cargo, positivo = abono
  type            String   // cargo | abono
  // Datos parseados de la descripción (cuando es transferencia)
  externalRef     String?  // n° documento del banco
  counterpartyName String? // nombre extraído ("Brune Spa", "Maria Carolina", ...)
  counterpartyRut  String? // RUT extraído (los primeros 9-10 dígitos)
  // Categorización del movimiento. Cuando matchea a una factura, queda
  // null — la factura ya tiene su categoría. Cuando es egreso sin factura
  // (sueldo, previred, comisión, retiro personal, etc) acá se etiqueta.
  // Valores típicos: sueldo | previred | comision_bancaria | retiro_personal
  // | deposito_efectivo | otro_sin_factura | null.
  category        String?
  // Transferencia entre dos cuentas BLARQ (cta operativa ↔ cta sueldos).
  // Cuando se detecta, ambos lados se linkean entre sí. NO cuenta como
  // gasto ni ingreso real — es solo movimiento de fondos interno.
  internalTransferToId String? @unique
  // Status del proceso de conciliación. "sin_asignar" cuando todavía MJ
  // no decidió qué es. "conciliado" cuando matchea con factura.
  // "sin_factura" cuando es un egreso/ingreso categorizado pero sin
  // factura asociada (sueldo, transferencia, etc). "interno" para
  // transferencias entre cuentas BLARQ.
  status          String   @default("sin_asignar")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  payments        InvoicePayment[]
  internalTransferTo BankMovement? @relation("InternalTransfer", fields: [internalTransferToId], references: [id])
  internalTransferFrom BankMovement? @relation("InternalTransfer")

  // Idempotencia del import: misma cuenta + fecha + monto + descripción
  // + ref no se duplica si MJ vuelve a importar la misma cartola.
  @@unique([bankAccountId, date, amount, description], name: "movement_unique")
  @@index([bankAccountId])
  @@index([date])
  @@index([status])
}

// Reembolsadores: personas (maestros, socios, MJ misma) que compran a
// nombre de BLARQ con su tarjeta personal y BLARQ les transfiere para
// reembolsarles. La transferencia bancaria sale a su nombre, pero la
// factura asociada es del proveedor real (Sodimac, MercadoLibre, etc.).
//
// Casos típicos: Cristobal y Elias (también fletes — facturados por
// Paula Johanna), JP, MJ misma, eventualmente otros maestros.
//
// Cuando un BankMovement tiene una glosa que contiene el patrón de un
// reembolsador, el modal "Asignar pagos" cambia su comportamiento:
//   - Apaga "Mismo proveedor" por default (la contraparte del banco no
//     es el RUT de la factura).
//   - Ordena las facturas con monto exacto match arriba.
//   - Muestra un banner explicativo.
model Reembolsador {
  id        String   @id @default(cuid())
  nombre    String   // Nombre legible — "Cristobal", "Elias", "JP", "MJ"
  glosa     String   // Texto que se busca (case-insensitive) en BankMovement.description
  // Alias de proveedor: si el movimiento bancario va al RUT de una
  // persona (ej "Jose Perez") pero las facturas las emite una empresa
  // suya (ej "JPB SpA", RUT 77...), seteá aquí el RUT de la empresa.
  // Cuando matchea la glosa, el modal de conciliación filtra facturas
  // por este RUT en vez de buscar por contraparte. Si está vacío, el
  // Reembolsador funciona como antes (compras personales reembolsables).
  rutAlias     String?
  businessName String?  // nombre legible de la empresa alias (informativo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([glosa])
  @@index([glosa])
  @@index([rutAlias])
}
