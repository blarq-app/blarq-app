generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USUARIOS ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("colaborador") // admin | colaborador
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== PROYECTOS ====================

model Project {
  id              String   @id @default(cuid())
  // Numeración correlativa: cada proyecto vive primero como cotización
  // (numeroCotizacion asignado al crear) y, si se aprueba, recibe un
  // numeroProyecto. Ambos son monotónicos y nunca se reusan.
  // Excepción: registros internos (BLARQ y centros de costo) tienen
  // ambos en null y se distinguen por isInternal.
  numeroCotizacion Int?    @unique
  numeroProyecto   Int?    @unique
  isInternal       Boolean @default(false)

  name            String
  clientName      String
  // RUT del cliente final (receptor del DTE cuando emitamos factura).
  // Se guarda normalizado sin puntos pero CON guión y DV mayúscula:
  // "12345678-9", "76123456-K". Validación de formato + DV chileno
  // (módulo 11) en `src/lib/clients/rut.ts`. Opcional por ahora porque
  // los proyectos existentes no tienen este dato — se completa cuando
  // MJ los va tocando, o como pre-requisito al emitir factura.
  clientRut       String?
  clientPhone     String?
  clientEmail     String?
  address         String?
  // cotizacion | ejecucion | terminado | archivado
  // (legacy "aprobado" → "ejecucion" en migración 2026-04-28)
  status          String   @default("cotizacion")
  startDate       DateTime?
  estimatedEndDate DateTime?
  actualEndDate   DateTime?
  currentVersion  String   @default("V1")
  ufReference     Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budgetVersions  BudgetVersion[]
  invoices        Invoice[]
  maestroId       String?
  maestro         Maestro?        @relation(fields: [maestroId], references: [id])
  estadosPago     EstadoPago[]
  shoppingItems   ShoppingItem[]
  invoiceRules    InvoiceCategorizationRule[]
  pendingTags     PendingProjectTag[]
  // Movimientos bancarios conciliados a esta obra a mano (hoy: transferencias
  // internas Operativa→Sueldos imputadas a la obra). Ver BankMovement.projectId.
  bankMovements   BankMovement[]
  // Objetivos % de la fila AVANCE del Cuadro Resumen, guardados por concepto
  // (ej. {"obra":65,"cocina":100}). Es el borrador del próximo avance que MJ
  // está armando para el cliente — se guarda para no perderlo al navegar.
  avanceObjetivos Json?

  @@index([maestroId])
  @@index([status])
}

// ==================== MAESTROS (mano de obra) ====================

model Maestro {
  id            String   @id @default(cuid())
  name          String
  rut           String?
  phone         String?
  emitsInvoice  Boolean  @default(false) // ¿emite factura?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      Project[]
}

// ==================== ESTADOS DE PAGO ====================

model EstadoPago {
  id              String   @id @default(cuid())
  projectId       String
  budgetVersionId String?  // versión del presupuesto base de este EP (null si es legacy o todavía no asociado)
  number          Int      // correlativo por proyecto: 1, 2, 3...
  date            DateTime @default(now())
  status          String   @default("borrador") // borrador | cerrado
  closedAt        DateTime? // se setea cuando status pasa a cerrado
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetVersion   BudgetVersion?   @relation(fields: [budgetVersionId], references: [id])
  items           EstadoPagoItem[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([budgetVersionId])
}

model EstadoPagoItem {
  id                  String   @id @default(cuid())
  estadoPagoId        String
  obraItemId          String   // Apunta al ObraItem de la versión actual del presupuesto. Se refresca al sync.
  lineageId           String   @default(cuid()) // Identidad estable de la partida a través de versiones del presupuesto.
  // Snapshot al momento del EP (se actualiza al sync)
  chapter             String
  // Sub-chapter / zona (ej "COCINA", "BAÑO") — snapshot de ObraItem.subChapter.
  // Permite que el EP muestre la misma separacion por zona que el presupuesto.
  subChapter          String?
  itemNumber          String
  name                String
  descriptionMaestro  String?  @map("description") // Snapshot de ObraItem.descriptionMaestro
  unit                String
  quantity            Float    // cantidad_total presupuestada (snapshot, refrescable al sync)
  laborUnitPrice      Float    // MO unitaria (snapshot, refrescable al sync)
  laborTotal          Float    // referencial = quantity × laborUnitPrice
  // Avance — la verdad financiera ahora vive aquí
  quantityExecuted    Float    @default(0) // cantidad ejecutada acumulada al final de ESTE EP
  // Snapshot inmutable que se setea al cerrar el EP
  amountPaid          Float?   // (quantityExecuted - prevExecuted) × laborUnitPrice al momento de cierre
  // Marcado por sync: partida que existía en la versión vieja del presupuesto pero no en la nueva
  outOfScope          Boolean  @default(false)
  // Legacy / derivado: lo dejamos por backward-compat pero ahora se calcula desde quantityExecuted
  pctAccumulated      Float    @default(0)
  sortOrder           Int      @default(0)

  estadoPago          EstadoPago @relation(fields: [estadoPagoId], references: [id], onDelete: Cascade)

  @@unique([estadoPagoId, obraItemId])
  @@unique([estadoPagoId, lineageId])
  @@index([estadoPagoId])
  @@index([obraItemId])
  @@index([lineageId])
}

// ==================== PRESUPUESTOS ====================

model BudgetVersion {
  id          String   @id @default(cuid())
  projectId   String
  version     String   // V1, V2, V3...
  parentVersionId String? // Versión origen cuando se duplica (V2.parentVersionId = V1.id). Null para versiones creadas desde cero.
  date        DateTime @default(now())
  status      String   @default("borrador") // borrador | enviado | aprobado | rechazado
  type        String   // obra | muebles | artefactos
  observations String?
  ggPercentage    Float?  @default(20)  // Solo para obra
  utilityPercentage Float? @default(5)  // Solo para obra
  // Descuento global aplicado al subtotal (decimal: 0.02 = 2%). Usado
  // típicamente en muebles cuando se cierra el deal. Aplica al subtotal
  // c/IVA y c/neto antes de mostrarlo como "total acordado".
  discountPercentage Float? @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foto inmutable de la versión al momento de enviarla/cerrarla: copia
  // profunda de las partidas + su desglose + totales tal cual se mandó al
  // cliente. Una vez enviada, la versión queda DESLIGADA del catálogo (el
  // sync nunca la toca) y se puede editar a mano sin reconectarla. La foto
  // es el registro de "esto fue lo que se envió el día X" y habilita el
  // "volver a lo enviado". Null mientras nunca se envió. Ver ADR/WIP (9).
  sentSnapshot Json?
  sentAt       DateTime?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentVersion BudgetVersion? @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions BudgetVersion[] @relation("VersionLineage")
  obraItems   ObraItem[]
  muebleChapters MuebleChapter[]
  muebleItems MuebleItem[]
  artefactoItems ArtefactoItem[]
  paymentTerms PaymentTerm[]
  estadosPago EstadoPago[]

  @@index([projectId])
  @@index([parentVersionId])
}

// Partidas de obra
model ObraItem {
  id                String  @id @default(cuid())
  budgetVersionId   String
  lineageId         String  @default(cuid()) // Identidad estable de la partida a través de versiones del presupuesto. Se preserva al duplicar la versión.
  chapter           String  // demoliciones, reparaciones, electricas, sanitarias, terminaciones, limpieza
  // Sub-chapter opcional dentro del chapter (ej: "COCINA", "BAÑO PRINCIPAL"
  // dentro de "INSTALACIONES SANITARIAS"). Solo se usa como separador visual
  // en el editor y PDF — no afecta cálculos. Null = sin sub-chapter.
  subChapter        String?
  itemNumber        String  // 1.1, 1.2, etc (legacy — el display usa correlativo recalculado)
  name              String
  descriptionCliente String? @map("description") // Va en el PDF del presupuesto
  descriptionMaestro String? // Va al estado de pago del maestro
  unit              String  // M2, ML, UN, GL
  quantity          Float
  unitPrice         Float
  total             Float
  // Desglose interno (no visible al cliente)
  costMaterial      Float?
  costLabor         Float?
  costSubcontract   Float?
  costMargin        Float?
  costTools         Float?
  costLoss          Float?
  sortOrder         Int     @default(0)
  catalogPartidaId  String?
  isCustomized      Boolean @default(false) // True si la partida fue editada respecto a su PartidaCatalog origen, o si fue creada manualmente sin catálogo. Habilita "refrescar precios desde catálogo" sin pisar customizaciones.

  budgetVersion     BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  components        ObraItemComponent[]
  discardedCatalogComponents ObraItemDiscardedCatalogComponent[]

  @@index([budgetVersionId])
  @@index([catalogPartidaId])
  @@index([lineageId])
}

// Snapshot de los componentes de una partida AL MOMENTO de crearse el ObraItem
// (regla MJ 2026-05-05: una cotización aprobada debe ser inmutable ante
// cambios al catálogo). Cada ObraItem tiene su propia copia denormalizada
// de los componentes que se usan en la lista de compras y EPs. Si JT edita
// el catálogo después, los proyectos vivos NO se ven afectados.
//
// Schema replica PartidaComponent uno-a-uno para mantener compatibilidad
// con el editor existente. La diferencia: la FK apunta a ObraItem en lugar
// de PartidaCatalog.
model ObraItemComponent {
  id            String   @id @default(cuid())
  obraItemId    String
  type          String   // material | mano_obra | margen | herramientas | subcontrato | perdida
  description   String
  unit          String   // UN, M2, ML, %, GL, DIA
  quantity      Float    @default(0)
  unitCost      Float    @default(0)
  totalCost     Float    @default(0)
  referenceLink String?
  materialId    String?  // referencia al catálogo de materiales
  // FK al PartidaComponent original del catálogo de donde se copió este
  // componente. Null si: (a) el componente lo creó MJ manualmente en la
  // cotización, (b) la partida no vino de catálogo, o (c) es data vieja
  // anterior al 2026-05-15. Habilita el "diff" del sync con el catálogo:
  // agregar faltantes, borrar los que ya no están, sin matching frágil.
  originComponentId String?
  // Marca true cuando MJ edita este componente manualmente desde el editor
  // del presupuesto. El sync automático con MaterialCatalog respeta este
  // flag — no pisa componentes personalizados para ese proyecto.
  isCustomized  Boolean  @default(false)
  sortOrder     Int      @default(0)
  appliedToComponentId String?
  appliedToType        String?

  obraItem      ObraItem @relation(fields: [obraItemId], references: [id], onDelete: Cascade)
  material      MaterialCatalog? @relation(fields: [materialId], references: [id])

  @@index([obraItemId])
  @@index([materialId])
  @@index([originComponentId])
}

// Registro de componentes del catálogo que MJ borró intencionalmente del
// editor de una cotización. Cuando el sync corre, NO recrea componentes
// del catálogo cuyo id figure acá — respetando la decisión local para
// ese proyecto. Si MJ después agrega ese mismo componente a mano vuelve
// a aparecer, pero el sync masivo no lo reintroduce solo.
model ObraItemDiscardedCatalogComponent {
  id                 String   @id @default(cuid())
  obraItemId         String
  partidaComponentId String   // id de PartidaComponent (no es FK real porque el componente del catálogo puede haber sido borrado posteriormente)
  createdAt          DateTime @default(now())

  obraItem           ObraItem @relation(fields: [obraItemId], references: [id], onDelete: Cascade)

  @@unique([obraItemId, partidaComponentId])
  @@index([obraItemId])
}

// Capítulos de muebles. Un proyecto puede tener varios:
// "MUEBLES DE COCINA", "CLOSET DORMITORIO", "WALK-IN", etc.
model MuebleChapter {
  id              String  @id @default(cuid())
  budgetVersionId String
  chapterNumber   Int     // 1, 2, 3 — para numeración (1 MUEBLES DE COCINA → items 1.1, 1.2)
  name            String  // "MUEBLES DE COCINA"
  sortOrder       Int     @default(0)

  budgetVersion   BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  items           MuebleItem[]

  @@index([budgetVersionId])
}

// Items dentro de un capítulo. Ej: 1.1 MUEBLES, 1.2 HERRAJES, 1.3 CUBIERTAS.
// Cada item tiene su propio cálculo de costo (proveedor, distribuidor, utilidad).
model MuebleItem {
  id                 String  @id @default(cuid())
  budgetVersionId    String  // Denormalizado para queries rápidas (mismo de chapter.budgetVersionId)
  chapterId          String
  itemNumber         String  // "1.1", "1.2", "1.3"
  name               String  // "MUEBLES", "HERRAJES", "CUBIERTAS"
  descriptionGeneral String? // "SEGÚN PLANOS ARQUITECTURA" — texto general bajo el nombre
  quantity           Float   @default(1)
  // Tipo de partida. "mueble" (default) = partida normal con costo manual /
  // cotizaciones de proveedor. "herrajes" = partida armada con líneas traídas
  // del catálogo de herrajes (ver MuebleHerraje): su costDistributor pasa a ser
  // DERIVADO = Σ(costNet × cantidad) de sus líneas, y el header de costo queda
  // de solo lectura (lo maneja la lista de herrajes). Fase 2 herrajes 2026-06-22.
  kind               String  @default("mueble") // mueble | herrajes
  // Cálculo interno
  supplier           String?
  costDistributor    Float   @default(0) // Lo que paga BLARQ al proveedor
  utilityPercentage  Float   @default(0) // Margen como decimal: 0.36 = 36%
  clientPriceNet     Float   @default(0) // Neto al cliente = costDistributor × (1 + utility)
  clientPriceIva     Float   @default(0) // C/IVA al cliente = clientPriceNet × 1.19
  sortOrder          Int     @default(0)

  budgetVersion      BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  chapter            MuebleChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  details            MuebleDetail[]
  quotes             MuebleQuote[]
  herrajes           MuebleHerraje[]

  @@index([budgetVersionId])
  @@index([chapterId])
}

// Cotizaciones alternativas para un MuebleItem. Una está marcada como
// `isSelected=true` (la activa) — sus valores se denormalizan en el item
// y son los que se muestran en el PDF al cliente y cuentan en totales.
// Las otras quedan como referencia para comparar precios entre proveedores.
model MuebleQuote {
  id                String  @id @default(cuid())
  itemId            String
  supplier          String?
  costDistributor   Float   @default(0)
  utilityPercentage Float   @default(0) // decimal: 0.36 = 36%
  clientPriceNet    Float   @default(0) // calculado: cost × (1 + util)
  clientPriceIva    Float   @default(0) // calculado: net × 1.19
  notes             String?
  isSelected        Boolean @default(false)
  sortOrder         Int     @default(0)

  item              MuebleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Detalle de componentes bajo un MuebleItem.
// Ej. para 1.1 MUEBLES: CUERPO INTERIOR / TRASERA / FRENTE BASE / FRENTE MURAL / ZOCALO,
// cada uno con su materialidad ("MELAMINA BLANCA 18MM, TAPACANTO PVC 0,4MM").
model MuebleDetail {
  id        String  @id @default(cuid())
  itemId    String
  name      String  // "CUERPO INTERIOR", "TRASERA"
  material  String  // "MELAMINA BLANCA 18MM, TAPACANTO PVC 0,4MM"
  sortOrder Int     @default(0)

  item      MuebleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Línea de herraje dentro de una partida "HERRAJES" (MuebleItem.kind="herrajes").
// Cada línea es un herraje traído del catálogo (HerrajeCatalog), con su SECTOR
// (texto libre que nombra MJ: SECTOR LAVAPLATOS, ENCIMERA…), su cantidad y el
// COSTO CONGELADO al momento de agregarlo. El costo del item = Σ(costNet × qty)
// de sus líneas; el precio a cliente sale del margen del item (default 20%).
// El proveedor es por línea (se puede mezclar HBT y DPH). Fase 2, 2026-06-22.
//
// Por qué snapshot del costo (costNet) y no leer el catálogo en vivo: una
// cotización aprobada queda congelada (principles.md "presupuesto aprobado
// inmutable ante cambios al catálogo"). Guardamos también name/measure/finish/
// supplier para que la línea se siga viendo aunque el catálogo cambie o se
// borre el item de catálogo. catalogId queda como trazabilidad (puede ser null
// si el herraje se cargó a mano).
model MuebleHerraje {
  id         String  @id @default(cuid())
  itemId     String
  catalogId  String? // HerrajeCatalog.id de origen (trazabilidad; null si manual)
  sector     String  // texto libre: "SECTOR LAVAPLATOS", "ENCIMERA"…; "" = sin sector
  supplier   String  // HBT | DPH (snapshot — el proveedor es por línea)
  name       String  // snapshot del nombre del herraje
  measure    String? // snapshot de la medida ("500mm")
  finish     String? // snapshot del color/terminación
  sku        String? // snapshot del SKU del proveedor
  quantity   Float   @default(1)
  costNet    Float   @default(0) // costo unitario CONGELADO al agregar (lo que cobra el proveedor)
  sortOrder  Int     @default(0)

  item       MuebleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([catalogId])
}

// Catálogo BLARQ de artefactos — fuente reutilizable entre proyectos.
//
// La idea: MJ usa los mismos WC / muebles vanitorios / griferías en
// múltiples proyectos. En lugar de tipearlos cada vez, los promueve al
// catálogo y los agrega a cada presupuesto buscándolos.
//
// "isStandard" marca los items que forman parte de la paleta base
// BLARQ (los WCs favoritos, las griferías de siempre). Funciona como
// un filtro rápido en la UI: "mostrar solo mis estándares".
//
// "tag" es una key opcional para agrupar items por función (ej.
// "wc-piso", "wc-suspendido", "griferia-9cm", "mueble-vanitorio-80").
// La usaremos cuando armemos templates de espacio (sesión 5).
//
// "lastPriceCheck" se actualiza cuando MJ aprieta "Revisar precios"
// (sesión 4) — sirve para ordenar items por precio más viejo y avisar
// "este precio tiene 3 meses, revisalo".
// Tipos del catálogo de artefactos (Accesorios, Griferías, WC…), por pestaña.
// Antes vivían fijos en el código (TIPO_OPTIONS_BY_SUB); se movieron a la BD
// para que MJ los cree/renombre/reordene/borre. El artefacto sigue guardando
// el tipo por NOMBRE en su campo `tag` (no por id) — al renombrar un tipo se
// actualizan en bloque los `tag` de sus artefactos, igual que línea/color.
model ArtefactoTipo {
  id          String   @id @default(cuid())
  subcategory String   // sanitario | cocina | iluminacion
  name        String   // "Accesorios", "Griferías", "WC", …
  sortOrder   Int      @default(0) // orden manual de los tipos dentro de la pestaña
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subcategory, name]) // no dos tipos con el mismo nombre en una pestaña
  @@index([subcategory, sortOrder])
}

// Orden manual de los subgrupos (línea + color) DENTRO de un tipo. Es una tabla
// chica y aparte a propósito: el orden de los subgrupos NO puede colgarse del
// sortOrder de los artefactos (la mayoría tiene sortOrder=0 y el arrastre de
// items reasigna 0..n dentro del subgrupo, así que empatarían). Acá cada fila
// es un subgrupo identificado por (subcategory, tag/tipo, line, finish). line y
// finish vacíos se guardan como "" (el subgrupo "Sin línea / Otros"). Lo que no
// tiene fila cae a orden alfabético (fallback) — no hace falta sembrar nada.
// Orden manual de las CARPETAS dentro de un tipo. Cada fila es una carpeta
// identificada por (subcategory, tag, subgroup). subgroup "" = la carpeta "Sin
// carpeta / Otros". Lo que no tiene fila cae a orden alfabético (fallback).
// (Antes esta tabla se key-eaba por line+finish; cambió al pasar a carpetas.)
model ArtefactoSubgroupOrder {
  id          String   @id @default(cuid())
  subcategory String   // sanitario | cocina | iluminacion
  tag         String   // nombre del tipo ("Griferías", …); "" = sin tipo
  subgroup    String   // nombre de la carpeta; "" = "Sin carpeta / Otros"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subcategory, tag, subgroup])
  @@index([subcategory, tag, sortOrder])
}

model ArtefactoCatalog {
  id                String   @id @default(cuid())
  name              String   // "WC ATENAS"
  detail            String?  // Modelo completo
  brand             String?
  subcategory       String   // sanitario | cocina | iluminacion
  tag               String?  // wc-piso, griferia-9cm, mueble-vanitorio-80, etc.
  // Línea comercial (familia de productos) y color/terminación. Sirven sobre
  // todo en sanitario, donde MJ compra "por línea" (Asis, Urban, Stellar…) y
  // por color (cromo, brushed, gun grey…). Se rellenan parseando el nombre y
  // quedan editables. Nullable: cocina/iluminación suelen no tener línea.
  line              String?  // Asis, Urban, Stellar, New Home, Atlas, Atenas, Delfos…
  finish            String?  // Cromo, Brushed, Gun Grey, Negro Mate, Blanco…
  // Carpeta MANUAL dentro de un tipo (rediseño "carpetas a mano" 2026-06-19).
  // Antes los subgrupos se calculaban de line+finish, y editar la línea
  // separaba/reagrupaba solo. Ahora la agrupación visual es esta carpeta, que
  // MJ arma a gusto; line/finish quedan como etiquetas y NO deciden el grupo.
  // Es el NOMBRE de la carpeta dentro de (subcategory, tag). Null = "sin
  // carpeta". Se sembró parseando line+finish para no mover nada el día 1.
  subgroup          String?
  supplier          String?  // MK, CHC, Kitchen House, LED Studio, etc.
  referenceLink     String?  // URL del producto en la tienda
  imageUrl          String?  // URL de la imagen
  listPrice         Float    @default(0) // Precio web / lista: lo que el cliente pagaría comprando online (con IVA). Lo refresca "Revisar precios".
  discountPercent   Float?   // Legacy. Dejó de ser el driver del precio (rediseño precios 2026-06): ahora el precio a cliente y el costo van como montos explícitos abajo. Se conserva por compat.
  // Precio que MJ le cobra al cliente. Por defecto = listPrice (vende al
  // precio de internet); editable cuando le "comparte" algo de descuento.
  // Si queda null, se interpreta como = listPrice.
  clientPrice       Float?
  // Lo que realmente paga BLARQ: la vendedora le cotiza con un descuento
  // variable por producto (no hay nada fijo). Interno, NO visible al
  // cliente, y se carga a mano. La ganancia = clientPrice − realCostBlarq.
  realCostBlarq     Float?
  isStandard        Boolean  @default(false) // Parte de la paleta base BLARQ
  // Orden manual dentro de cada subcategoría (pestaña). MJ arrastra las
  // filas a su gusto y este número fija el orden; default 0 = todos los
  // existentes empatan y caen al orden por nombre hasta que ella arrastre.
  sortOrder         Int      @default(0)
  lastPriceCheck    DateTime? // Última vez que se verificó el precio
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subcategory])
  @@index([tag])
  @@index([isStandard])
  @@index([subcategory, sortOrder])
}

// Items de artefactos
model ArtefactoItem {
  id                String  @id @default(cuid())
  budgetVersionId   String
  room              String  // baño_principal, baño_secundario, cocina, etc
  subcategory       String  // sanitario | cocina | iluminacion
  name              String  // WC, GRIFERIA, etc
  detail            String? // Descripcion del producto
  brand             String?
  quantity          Int     @default(1)
  listPrice         Float   // Precio lista
  discountPercent   Float?  // % descuento al cliente
  clientPrice       Float   // Precio final al cliente
  // Interno (no visible al cliente)
  realCostBlarq     Float?  // Lo que realmente paga BLARQ
  referenceLink     String? // URL del producto en la tienda (mk.cl, sodimac, etc)
  imageUrl          String? // URL de la imagen — auto-extraída del referenceLink o pegada manual
  // Si este item viene del catálogo, guardamos el id para poder:
  //  - mostrar "este item está en catálogo" en la UI
  //  - sincronizar cambios de precio del catálogo a items de presupuestos
  //    en borrador (ver más abajo priceOverridden).
  catalogId         String?
  // "Despegada del catálogo" (rediseño precios artefactos 2026-06-18, ADR
  // 2026-06-18-artefactos-precios-catalogo-a-cotizacion). Mientras esté en
  // false, la línea SIGUE al catálogo: si MJ edita el precio maestro en
  // /catálogo (o aplica "Revisar precios"), esta línea se actualiza —pero
  // solo si la cotización está en borrador—. Cuando MJ edita la línea a mano
  // (precio, descuento, nombre, foto, etc.) se pone en true y el catálogo no
  // la vuelve a pisar nunca. Es el equivalente, por línea, de
  // ObraItem.isCustomized. Las cotizaciones enviadas quedan congeladas por
  // estado (el catálogo solo toca borradores), igual que en obra.
  priceOverridden   Boolean @default(false)
  sortOrder         Int     @default(0)

  budgetVersion     BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)

  @@index([budgetVersionId])
  @@index([catalogId])
}

// ==================== CATALOGO DE HERRAJES ====================
// Espejo del catálogo de artefactos, pero para herrajes de muebles (cajones
// metálicos, correderas, bisagras, despensas…). Es un catálogo SEPARADO porque
// los herrajes se compran por PROVEEDOR (HBT o DPH, que venden productos
// distintos para la misma función) y se arman por SECTOR del mueble (no por
// ambiente). Decisiones de MJ 2026-06-22.
//
// Diferencia clave con artefactos en el PRECIO: el herraje tiene UN costo neto
// (lo que cobra el proveedor) y el precio a cliente es costo × 1,2 (margen 20%,
// el flujo del Excel de MJ). No existe el trío listPrice/clientPrice/realCost de
// artefactos. `clientPrice` queda como override opcional: null = costNet × 1,2.
model HerrajeCatalog {
  id             String   @id @default(cuid())
  name           String   // nombre base del herraje, ej "CORREDERA OCULTA EXTENSIÓN TOTAL CIERRE SUAVE"
  detail         String?  // detalle libre extra
  // Proveedor del herraje. MJ elige HBT o DPH al cotizar y el catálogo se
  // filtra por este campo: cada proveedor tiene sus propios productos (HBT =
  // Blum con marca; DPH = genérico equivalente). NO es el mismo herraje con
  // dos precios.
  supplier       String   // HBT | DPH
  // Familia/pestaña del catálogo (lo que en artefactos es `subcategory`):
  // cajon | corredera | bisagra | despensa. MJ agrega más después.
  category       String
  // Agrupación dentro de la familia (lo que en artefactos es `tag`/subgrupo):
  // cajón → "Interior" | "Frente madera"; bisagra → "Sin retén" | "Marco
  // aluminio" | "Esquinera" | "Especiales" | "Cierre suave 3D"; etc.
  subgroup       String?
  measure        String?  // medida: "350mm", "500mm"… (null si no aplica, ej. bisagras)
  finish         String?  // color/terminación: Blanco, Níquel, Negro…
  brand          String?  // marca: Blum, NKO, genérico…
  sku            String?  // SKU del proveedor (ej. CORRE555500)
  referenceLink  String?  // URL del producto en el sitio del proveedor
  imageUrl       String?  // URL de la imagen
  costNet        Float    @default(0) // costo neto (lo que cobra el proveedor, sin IVA o como lo publica)
  // Precio a cliente. null = costNet × 1,2 (el caso normal). Editable si MJ
  // quiere fijar otro precio en un caso puntual.
  clientPrice    Float?
  // Orden manual dentro de (supplier, category). default 0 = empatan y caen al
  // orden por nombre hasta que MJ arrastre.
  sortOrder      Int      @default(0)
  lastPriceCheck DateTime? // última vez que se revisó el precio online
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supplier])
  @@index([category])
  @@index([supplier, category, sortOrder])
}

// Formas de pago por presupuesto
model PaymentTerm {
  id                String  @id @default(cuid())
  budgetVersionId   String
  stage             String  // anticipo | avance1 | avance2 | saldo
  percentage        Float
  amount            Float?  // Calculado
  sortOrder         Int     @default(0)

  budgetVersion     BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)

  @@index([budgetVersionId])
}

// ==================== CATALOGO DE PARTIDAS ====================

// Partida del catálogo global (reutilizable entre proyectos)
model PartidaCatalog {
  id                 String   @id @default(cuid())
  category           String   // OBRAS PRELIMINARES, DEMOLICIONES, etc
  name               String   // CIERRE OSB, DEMOLICION TABIQUE, etc
  descriptionCliente String?  @map("description") // Va en el PDF del cliente (se propaga a ObraItem)
  descriptionMaestro String?  // Va en el estado de pago del maestro (se propaga a ObraItem y EstadoPagoItem)
  sortOrder          Int      @default(0) // Orden manual dentro de la categoría
  unit               String   // M2, ML, UN, GL
  unitPrice          Float    @default(0) // Precio unitario de referencia
  // Desglose de costos
  costMaterial  Float    @default(0)
  costLabor     Float    @default(0)
  costTools     Float    @default(0)
  costMargin    Float    @default(0)
  costLoss      Float    @default(0)
  costSubcontract Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components    PartidaComponent[]

  @@unique([category, name])
  @@index([category])
}

// Componentes de una partida (materiales, mano de obra, etc.)
model PartidaComponent {
  id            String   @id @default(cuid())
  partidaId     String
  type          String   // material | mano_obra | margen | herramientas | subcontrato | perdida
  description   String   // SACO YESO 25KG, MAESTRO, etc
  unit          String   // UN, M2, ML, %, GL, DIA
  quantity      Float    @default(0)
  unitCost      Float    @default(0) // P. CONCEPTO NETO
  totalCost     Float    @default(0) // P.U NETO (qty * unitCost)
  referenceLink String?  // Link Sodimac, etc
  materialId    String?  // Referencia al catálogo de materiales
  sortOrder     Int      @default(0)
  // Para componentes con unit="%" — sobre qué se aplica el porcentaje:
  //   - margen: applied* todos null, total = % × suma del resto excepto pérdida.
  //   - perdida: appliedToComponentId apunta a un componente concreto (típica-
  //     mente un material) de la misma partida. total = % × totalCost de ese.
  //   - leyes (mano_obra con unit="%"): appliedToType = "mano_obra".
  //     total = % × suma de mano_obra (no-%) de la partida.
  appliedToComponentId String?
  appliedToType        String? // "mano_obra" | "material" | etc.

  partida       PartidaCatalog @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  material      MaterialCatalog? @relation(fields: [materialId], references: [id])

  @@index([partidaId])
  @@index([materialId])
}

// ==================== CATALOGO DE MATERIALES ====================

model MaterialCatalog {
  id            String   @id @default(cuid())
  category      String   // SACOS, FIJACIONES, PINTURAS, etc
  name          String   @unique // SACO YESO 25KG, etc
  unit          String   @default("UN")
  netPrice      Float    @default(0) // Precio neto actualizado
  isProvision   Boolean  @default(false) // Provisión al cliente (no es producto Sodimac)
  referenceLink String?  // Link Sodimac, etc
  lastUpdated   DateTime @default(now())
  lastResearchAt DateTime? // última vez que buscamos precios online
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components    PartidaComponent[]
  obraItemComponents ObraItemComponent[]
  shoppingItems ShoppingItem[]
  priceOffers   MaterialPriceOffer[]
}

// Ofertas de precio por tienda para un material
model MaterialPriceOffer {
  id           String   @id @default(cuid())
  materialId   String
  store        String   // sodimac | easy | construmart | mercadolibre | imperial | chilemat | otro
  productName  String   // nombre exacto en la tienda
  productUrl   String?
  price        Float    // precio (con IVA tal como aparece en la web)
  priceNet     Float?   // precio neto calculado (price / 1.19)
  available    Boolean  @default(true)
  isPinned     Boolean  @default(false) // elegido por el usuario como fuente oficial
  notes        String?
  checkedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material     MaterialCatalog @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([store])
}

// Historial de precios (snapshot cada vez que se refresca)
model MaterialPriceHistory {
  id         String   @id @default(cuid())
  materialId String
  store      String
  price      Float
  checkedAt  DateTime @default(now())

  @@index([materialId])
  @@index([checkedAt])
}

// ==================== LISTA DE COMPRA ====================

model ShoppingItem {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  unit        String   @default("UN")
  qtyNeeded   Float    @default(0)
  qtyBought   Float    @default(0)
  notes       String?
  materialId  String?
  manualAdd   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material    MaterialCatalog? @relation(fields: [materialId], references: [id])

  @@index([projectId])
  @@index([materialId])
}

// ==================== CATEGORIAS DE COSTO ====================

model CostCategory {
  id          String  @id @default(cuid())
  name        String
  parentId    String? // Para subcategorias
  type        String  @default("directo") // directo | indirecto
  // A qué tipo de factura aplica esta categoría:
  //   "recibida" = solo facturas que llegan a BLARQ (proveedores). Default.
  //                Acá vivien Materiales, MO, Herramientas, Subcontrato, etc.
  //   "emitida"  = solo facturas que emite BLARQ al cliente. Acá viven
  //                Obra, Muebles, Artefactos (top-level del cobro).
  //   "both"     = aplica a ambas (raro, dejado por completitud).
  appliesTo   String  @default("recibida")
  sortOrder   Int     @default(0)

  parent      CostCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children    CostCategory[] @relation("CategoryParent")
  invoices    Invoice[]
  invoiceRules InvoiceCategorizationRule[]
  pendingTags PendingProjectTag[]

  @@index([parentId])
}

// ==================== FACTURAS ====================

model Invoice {
  id              String   @id @default(cuid())
  projectId       String?
  categoryId      String?
  type            String   // emitida | recibida
  // Identidad SII (DTE):
  // - tipoDoc: 33=factura electrónica, 34=factura exenta, 39=boleta,
  //   41=boleta exenta, 56=nota débito, 61=nota crédito.
  // - folioNumber, rutIssuer son los identificadores del DTE.
  // - rutReceiver: para facturas recibidas es BLARQ; para emitidas es el cliente.
  // El triple (tipoDoc, folioNumber, rutIssuer) más type es único — sirve para
  // el upsert idempotente del cron de sincronización SII.
  tipoDoc         Int?
  folioNumber     String?
  rutIssuer       String?
  rutReceiver     String?
  businessName    String?
  issueDate       DateTime
  dueDate         DateTime?
  netAmount       Float
  iva             Float
  totalAmount     Float
  status          String   @default("pendiente") // pendiente | pagada | anulada
  // Fecha en que la factura fue efectivamente pagada (set automáticamente
  // al conciliar con un movimiento bancario). null si todavía está pendiente.
  paidAt          DateTime?
  // conceptoCobro: solo aplica a facturas EMITIDAS. Indica qué tipo de
  // cobro es para el cálculo del fondo sueldos:
  //   - "obra"       → suma a "cobrado obra", aporta GG×pct al fondo
  //   - "muebles"    → suma a "cobrado muebles", aporta utilidad×pct al fondo
  //   - "artefactos" → suma a "cobrado artefactos", NO aporta al fondo
  //   - "mixto"      → MJ define el split en porcentajes (campo extra a futuro)
  // Para facturas recibidas, queda null (no aplica).
  conceptoCobro   String?
  // Desglose REAL de un cobro de ARTEFACTOS entre sus sub-categorías
  // (cocina / sanitarios / iluminación). El Cuadro Resumen necesita repartir
  // cada cobro de artefactos entre las 3 columnas; por default lo hace
  // proporcional al presupuesto, pero eso falla cuando el cobro no siguió ese
  // reparto (ej. se cobró cocina+sanitarios pero NADA de iluminación, que se
  // agregó después). Si estos campos están seteados (alguno no-null), el cuadro
  // usa estos montos en vez del reparto proporcional. Null = proporcional.
  // Solo aplican a facturas emitidas con concepto artefactos.
  artefactoCocina      Float?
  artefactoSanitario   Float?
  artefactoIluminacion Float?
  // Referencia a otra factura cuando este DTE la modifica.
  // Solo aplica a NC (tipoDoc=61) y ND (tipoDoc=56), que en Chile siempre
  // referencian la factura original que cancelan/ajustan.
  // referenceFolioNumber + referenceTipoDoc (típicamente 33) identifican
  // ese DTE original. Si la factura original existe en la app, se puede
  // resolver el id por (type, tipoDoc=referenceTipoDoc, folioNumber=
  // referenceFolioNumber, rutIssuer del mismo emisor).
  referenceFolioNumber String?
  referenceTipoDoc     Int?
  // Compensación de NC (tipoDoc=61). Tres modos:
  //   "other_invoice": el proveedor aplica el crédito a OTRA factura
  //     (caso DP — comprás, devolvés, te compensan en la próxima compra).
  //     compensationType = "other_invoice" + appliedToInvoiceId = factura cubierta.
  //   "cash_refund": el proveedor devuelve la plata en efectivo
  //     (caso Sodimac). compensationType = "cash_refund" sin asociaciones.
  //   "bank_refund": el proveedor devuelve la plata a tu cuenta bancaria.
  //     compensationType = "bank_refund" + refundBankMovementId = ID del
  //     BankMovement entrante donde se acreditó la devolución.
  // En los tres casos la NC ya está "consumida" — no aparece como
  // pendiente ni genera ruido visual. La factura compensada (en el modo
  // other_invoice) queda cubierta por la suma de InvoicePayments + monto
  // de NCs aplicadas.
  compensationType        String?  // "other_invoice" | "cash_refund" | "bank_refund" | null
  appliedToInvoiceId      String?
  refundBankMovementId    String?
  origin          String   @default("manual") // manual | sii_automatica
  // Trazabilidad SII (cuando origin = sii_automatica)
  siiTrackId      String?  // Identificador del DTE en SII (track id que devuelve el proveedor)
  xmlUrl          String?  // URL al XML del DTE (cuando OpenFactura lo expone)
  pdfUrl          String?  // URL al PDF del DTE
  syncedAt        DateTime? // Última vez que se trajo/refrescó del SII
  // PDF oficial del SII cacheado en BD. Se baja vía sync local con cert digital
  // (scripts/sync-sii-pdfs.ts). siiCodigo es el ID interno del SII para el
  // endpoint mipeShowPdf.cgi (~10 dígitos, único por DTE).
  // pdfFetchedAt: null = nunca se intentó; con valor = se intentó (con o sin
  // éxito; si pdfContent es null entonces el DTE no aparece en mipeAdminDocsRcp).
  siiCodigo       String?
  pdfContent      Bytes?
  pdfFetchedAt    DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project?      @relation(fields: [projectId], references: [id])
  category        CostCategory? @relation(fields: [categoryId], references: [id])
  payments        InvoicePayment[]

  @@unique([type, tipoDoc, folioNumber, rutIssuer], name: "dte_unique")
  @@index([projectId])
  @@index([categoryId])
  @@index([origin, projectId]) // para query "SII sin asignar"
  @@index([siiTrackId])
  @@index([appliedToInvoiceId]) // para sumar NCs aplicadas a una factura
}

// Imputación de un movimiento bancario a una factura. Sirve para cobros
// parciales (varios movimientos contra una factura) y splits (un
// movimiento contra varias facturas — caso típico: cliente transfiere un
// monto único que cubre obra + muebles + artefactos en facturas separadas).
//
// Reglas:
//   - amountApplied es siempre positivo (CLP). El "sentido" lo da el tipo
//     de factura: emitida=cobro, recibida=pago.
//   - Σ(amountApplied where invoiceId=X) define el status de la factura:
//       0                    → pendiente
//       0 < sum < totalAmount → parcial
//       sum >= totalAmount   → pagada (paidAt = max(date) de los movs)
//   - Σ(amountApplied where bankMovementId=Y) ≤ |amount| del mov. El
//     resto del monto puede estar sin imputar (típico cuando el abono
//     incluye plata que no es de facturas — ej, pago al maestro JT).
// Regla de auto-categorización de movimientos bancarios. Cuando MJ
// categoriza un movimiento manualmente, se guarda una regla que matchea
// movimientos futuros con descripción similar y les aplica la misma
// categoría. Eso ahorra clicks repetidos en cada cartola que entra.
//
// La regla matchea por substring case-insensitive contra
// BankMovement.description. El patrón se deriva de las primeras palabras
// de la descripción al crear la regla; MJ puede editarlo después.
//
// Aplicación:
//   - En el import (después del auto-match contra facturas), se aplican
//     las reglas a movs que quedan sin_asignar.
//   - Cuando MJ categoriza manualmente, se actualiza/crea la regla en
//     paralelo al PATCH del movimiento.
// Regla de auto-categorización de facturas por proveedor.
// Cuando MJ asigna categoría a una factura recibida (manual o vía bulk),
// se crea/actualiza una regla "RUT proveedor → categoría". Próximas
// facturas que llegan con ese RUT (sync SII o creación manual) heredan
// la categoría automáticamente.
//
// El proyecto / centro de costo NUNCA se auto-asigna: depende del
// contexto temporal y MJ lo decide siempre a mano.
model InvoiceCategorizationRule {
  id           String   @id @default(cuid())
  rutIssuer    String   @unique // RUT del proveedor — único, una regla por proveedor
  businessName String?  // nombre referencial, se actualiza con la última factura vista
  // Acción de la regla. Al menos uno de los dos campos debe estar puesto:
  //   - categoryId: auto-asigna categoría al matchear el RUT
  //   - projectId: auto-asigna centro de costo (proyecto)
  // Si ambos están, la regla setea las 2 cosas en una pasada. Si solo
  // uno, ese campo se setea y el otro se respeta (no se sobreescribe).
  categoryId   String?
  projectId    String?
  hits         Int      @default(0) // cuántas facturas se categorizaron con esta regla
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     CostCategory? @relation(fields: [categoryId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  @@index([rutIssuer])
  @@index([categoryId])
  @@index([projectId])
}

// Etiqueta de centro de costo "en espera", capturada desde una foto vía el
// bot de Telegram. MJ/JT fotografían una factura de proveedor en el momento
// de la compra y escriben a qué obra (y opcional categoría) va. Pero la
// factura todavía NO llegó por el sync del SII (puede tardar horas o días).
//
// Esta tabla guarda la INTENCIÓN: "cuando llegue la factura folio X del RUT
// Y, asignala a esta obra/categoría". El sync (runSiiSync) la consume al
// crear/actualizar la factura y la marca como aplicada.
//
// Por qué no es una InvoiceCategorizationRule: aquella es por proveedor
// (RUT → siempre esta obra), y los proveedores acá son transversales
// (Sodimac compra para muchas obras). Esto es de UN SOLO USO, para una
// factura específica identificada por (rutIssuer, folioNumber).
//
// Identidad de la factura objetivo: (rutIssuer, folioNumber). El monto y la
// fecha leídos de la foto se guardan como respaldo para confirmar el match
// (la lectura de folio de una foto no es 100% confiable).
model PendingProjectTag {
  id              String    @id @default(cuid())
  // Identificadores del DTE leídos de la foto.
  rutIssuer       String    // RUT del proveedor (formato 12345678-9)
  folioNumber     String?   // folio de la factura; puede venir null si la foto no se leyó bien
  // Respaldo para confirmar el match contra la factura que llega del SII.
  totalAmount     Float?
  issueDate       DateTime?
  businessName    String?   // nombre del proveedor leído, referencial
  // Destino a aplicar.
  projectId       String?
  categoryId      String?
  // Quién la mandó (id numérico de Telegram + nombre para mostrar).
  requestedBy     String?
  requestedByName String?
  // Ciclo de vida:
  //   "por_confirmar" → obra leída a mano de la foto; espera que MJ/JT
  //                     toquen "Sí" en el botón antes de aplicarse.
  //   "esperando"     → confirmada; todavía no llegó la factura, el sync la busca.
  //   "aplicada"      → el sync (o la confirmación) la asignó.
  //   "descartada"    → MJ/JT la cancelaron, o no se pudo resolver.
  status          String    @default("esperando") // por_confirmar | esperando | aplicada | descartada
  appliedToInvoiceId String?
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project?      @relation(fields: [projectId], references: [id])
  category        CostCategory? @relation(fields: [categoryId], references: [id])

  // El sync busca por (rutIssuer, folioNumber, status) al llegar cada factura.
  @@index([rutIssuer, folioNumber, status])
  @@index([status])
}

model BankCategorizationRule {
  id                 String   @id @default(cuid())
  descriptionPattern String   // substring a buscar (case-insensitive)
  category           String   // sueldo | previred | comision_bancaria | etc
  hits               Int      @default(0) // cuántas veces se aplicó (señal de "regla útil")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([descriptionPattern, category])
}

model InvoicePayment {
  id              String       @id @default(cuid())
  bankMovementId  String
  invoiceId       String
  amountApplied   Float
  // true = la imputación la creó el auto-match (no MJ a mano). Sirve para
  // marcar en la UI las conciliaciones automáticas y poder auditarlas. Las
  // imputaciones manuales (modal, bulk assign, pago sin factura) quedan false.
  // Solo registra de acá en adelante — las viejas no se pueden distinguir.
  autoMatched     Boolean      @default(false)
  createdAt       DateTime     @default(now())

  bankMovement    BankMovement @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([bankMovementId, invoiceId], name: "payment_unique")
  @@index([invoiceId])
  @@index([bankMovementId])
}

// ==================== CUENTAS BANCARIAS Y MOVIMIENTOS ====================

// Las cuentas bancarias de BLARQ. Hoy son 2 (operativa y sueldos), pero
// el modelo soporta más (ahorro, dólares, etc).
model BankAccount {
  id            String   @id @default(cuid())
  // Número visible en cartola (ej: "0-000-8913459-5"). Único.
  accountNumber String   @unique
  // Nombre interno para mostrar (ej: "Operativa", "Sueldos").
  alias         String
  // role: operating (cta operativa) | salary_fund (fondo sueldos) | other.
  // Permite a la app aplicar reglas distintas — ej: el saldo de salary_fund
  // se muestra como "fondo disponible para sueldos" en el dashboard.
  role          String   @default("operating")
  bank          String   @default("Santander")
  currency      String   @default("CLP")
  // Último saldo conocido y la fecha a la que corresponde. Se actualiza
  // automáticamente al importar una cartola con fechaHasta posterior.
  // Es el dato oficial del banco — el "neto importado" sumando movimientos
  // no sirve si hay plata previa al primer import.
  lastKnownBalance     Float?
  lastKnownBalanceDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements     BankMovement[]
}

model BankMovement {
  id              String   @id @default(cuid())
  bankAccountId   String
  date            DateTime
  description     String   // descripción tal como viene en cartola
  amount          Float    // signed: negativo = cargo, positivo = abono
  type            String   // cargo | abono
  // Saldo corrido tras aplicar este movimiento. Se calcula al importar la
  // cartola, sobre un orden canónico (fecha, monto, descripción). YA NO es
  // la llave de deduplicación: resultó frágil cuando dos cartolas del mismo
  // período traen sets de movimientos distintos (la Provisoria es un
  // snapshot incompleto), porque eso corre el saldo y desincroniza la llave
  // (bug 2026-06-02). El dedup ahora va por huella estable — ver
  // src/lib/banco/dedup.ts. balanceAfter se conserva como dato informativo
  // y como segunda barrera vía el @@unique de abajo.
  // Nullable solo por los movimientos que ya existían antes del backfill
  // del 2026-05-17.
  balanceAfter    Float?
  // Datos parseados de la descripción (cuando es transferencia)
  externalRef     String?  // n° documento del banco (solo lo trae la cartola Histórica)
  counterpartyName String? // nombre extraído ("Brune Spa", "Maria Carolina", ...)
  counterpartyRut  String? // RUT extraído (los primeros 9-10 dígitos)
  // Categorización del movimiento. Cuando matchea a una factura, queda
  // null — la factura ya tiene su categoría. Cuando es egreso sin factura
  // (sueldo, previred, comisión, retiro personal, etc) acá se etiqueta.
  // Valores típicos: sueldo | previred | comision_bancaria | retiro_personal
  // | deposito_efectivo | otro_sin_factura | null.
  category        String?
  // Transferencia entre dos cuentas BLARQ (cta operativa ↔ cta sueldos).
  // Cuando se detecta, ambos lados se linkean entre sí. NO cuenta como
  // gasto ni ingreso real — es solo movimiento de fondos interno.
  internalTransferToId String? @unique
  // Grupo de "devolución neto cero": plata que entró y volvió (ej. la
  // clienta transfirió por error y se le devolvió). Todos los movimientos
  // del mismo lavado comparten este id. La suma del grupo es ≈ 0 y NO
  // cuenta como ingreso ni gasto. null = no es parte de un lavado.
  netZeroGroupId  String?
  // Obra a la que MJ concilió este movimiento, A MANO. Hoy se usa solo para
  // las transferencias internas Operativa→Sueldos (category="transfer_interno"):
  // permite ver, por proyecto, cuánta utilidad ya se traspasó a la cuenta
  // sueldos. NUNCA se auto-asigna (igual criterio que las facturas). Si se
  // borra la obra, queda null (onDelete: SetNull) — no rompe el movimiento.
  projectId       String?
  // Para transferencias internas Operativa→Sueldos: de qué utilidad es el
  // traspaso, "obra" | "muebles". (Artefactos no genera sueldo.) Permite, en
  // "Me paso a Sueldos", separar lo transferido por concepto y calcular cuánto
  // falta transferir de cada uno. null = sin clasificar todavía. Se setea a
  // mano (en /banco/movimientos) en los dos lados del par linkeado.
  internalConcepto String?
  // Status del proceso de conciliación. "sin_asignar" cuando todavía MJ
  // no decidió qué es. "conciliado" cuando matchea con factura.
  // "sin_factura" cuando es un egreso/ingreso categorizado pero sin
  // factura asociada (sueldo, transferencia, etc). "interno" para
  // transferencias entre cuentas BLARQ. "neto_cero" para devoluciones
  // que se cancelan entre sí (ver netZeroGroupId).
  status          String   @default("sin_asignar")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payments        InvoicePayment[]
  internalTransferTo BankMovement? @relation("InternalTransfer", fields: [internalTransferToId], references: [id])
  internalTransferFrom BankMovement? @relation("InternalTransfer")

  // Segunda barrera de idempotencia del import. La decisión real de qué es
  // duplicado la toma `planImportDedup` (src/lib/banco/dedup.ts) por huella
  // estable; este constraint queda como red de seguridad a nivel BD. Histórico:
  // hasta 2026-05-17 el dedup iba por N° de documento (externalRef), que la
  // Provisoria trae en cero → duplicaba entre formatos; se pasó a balanceAfter,
  // que falló cuando una cartola trae un set incompleto (bug 2026-06-02) →
  // se pasó a la huella estable.
  @@unique([bankAccountId, date, amount, balanceAfter], name: "movement_unique")
  @@index([bankAccountId])
  @@index([date])
  @@index([status])
  @@index([netZeroGroupId])
  @@index([projectId])
}

// Reembolsadores: personas (maestros, socios, MJ misma) que compran a
// nombre de BLARQ con su tarjeta personal y BLARQ les transfiere para
// reembolsarles. La transferencia bancaria sale a su nombre, pero la
// factura asociada es del proveedor real (Sodimac, MercadoLibre, etc.).
//
// Casos típicos: Cristobal y Elias (también fletes — facturados por
// Paula Johanna), JP, MJ misma, eventualmente otros maestros.
//
// Cuando un BankMovement tiene una glosa que contiene el patrón de un
// reembolsador, el modal "Asignar pagos" cambia su comportamiento:
//   - Apaga "Mismo proveedor" por default (la contraparte del banco no
//     es el RUT de la factura).
//   - Ordena las facturas con monto exacto match arriba.
//   - Muestra un banner explicativo.
model Reembolsador {
  id        String   @id @default(cuid())
  nombre    String   // Nombre legible — "Cristobal", "Elias", "JP", "MJ"
  glosa     String   // Texto que se busca (case-insensitive) en BankMovement.description (fallback)

  // RUT de la PERSONA tal como aparece en BankMovement.counterpartyRut
  // (formato banco, ej "0183655213"). Es la señal MÁS confiable para
  // detectar el reembolsador — el nombre/glosa puede ser ambiguo entre
  // personas, el RUT no. El matching prioriza personRut y cae a glosa.
  personRut String?

  // Aliases de proveedor (uno-a-muchos). Cuando un movimiento bancario
  // va a una persona pero esa persona compra a nombre de varias empresas
  // (ej. Cristobal compra a veces a Paula Johanna, a veces a Sodimac),
  // cada empresa se registra como un alias. El modal de conciliación
  // busca facturas que pertenezcan a CUALQUIERA de los RUTs listados.
  // Si la lista está vacía, el Reembolsador funciona como "compras
  // personales reembolsables" — la factura puede ser de cualquier RUT.
  aliases   ReembolsadorAlias[]

  // Campos legacy (un solo alias). Mantenidos para no perder data
  // durante la migración — el código nuevo lee de `aliases`. Una vez
  // que la migración terminó en prod, se pueden droppear.
  rutAlias     String?  // @deprecated — usar aliases[]
  businessName String?  // @deprecated — usar aliases[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([glosa])
  @@index([glosa])
  @@index([rutAlias])
  @@index([personRut])
}

model ReembolsadorAlias {
  id              String       @id @default(cuid())
  reembolsadorId  String
  // RUT de la empresa que emite facturas que se imputan a este
  // reembolsador. Guardado sin formato (solo dígitos) o con guion,
  // el matching se hace por substring de los últimos 8 dígitos.
  rut             String
  // Nombre legible de la empresa (ej "Paula Johanna", "Sodimac"). Solo
  // informativo — para mostrar en el banner del modal y en la UI.
  businessName    String?
  createdAt       DateTime     @default(now())

  reembolsador    Reembolsador @relation(fields: [reembolsadorId], references: [id], onDelete: Cascade)

  @@index([reembolsadorId])
  @@index([rut])
}

// ─────────────────────────────────────────────────────────────────────────
// Contabilidad — Remuneraciones (sueldos)
// ─────────────────────────────────────────────────────────────────────────

// Empleado con sueldo (dependiente) de BLARQ. Hoy son solo MJ y JT, ambos
// socios con contrato y liquidación mensual → Previred obligatorio. Estos
// parámetros alimentan el motor de liquidaciones (sueldos.ts) que arma el
// código 048 del F29 y la base de Previred.
//
// Antes vivían como constantes en remuneraciones.ts; se movieron a la base
// para tener una pantalla editable sin tocar código.
model Empleado {
  id          String  @id @default(cuid())
  nombre      String
  rut         String  @unique // formato con puntos y guion, ej "18.022.887-K"

  // Haberes fijos del contrato
  sueldoBase   Int
  colacion     Int @default(0) // no imponible, no tributable
  movilizacion Int @default(0) // no imponible, no tributable

  // AFP: 10% capitalización (fijo en el motor) + comisión de la AFP
  afpNombre      String? // informativo, ej "Planvital"
  afpComisionRate Float  // ej 0.0116 (1,16%)

  // Salud: plan de Isapre expresado en UF (se convierte a pesos con la UF
  // del mes). El mínimo legal es 7% del imponible; el exceso lo paga el
  // trabajador de su líquido.
  isapreNombre String? // informativo, ej "Colmena"
  isaprePlanUF Float

  // Permite "dar de baja" un empleado sin borrarlo (conserva el histórico
  // de liquidaciones de los meses en que estuvo activo).
  activo Boolean @default(true)

  // Ajustes del sueldo imponible mes a mes (cuando el bono varía).
  sueldosMensuales SueldoMensual[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ajuste del sueldo imponible de un empleado en un mes concreto. El sueldo de
// BLARQ es "base + bono" y el bono puede variar de un mes a otro; cuando eso
// pasa, este registro pisa el `sueldoBase` estándar del empleado SOLO para ese
// período. Si no hay registro para un mes, se usa el `Empleado.sueldoBase`.
//
// `sueldoBase` acá = base + bono imponible del mes (ANTES de la gratificación,
// igual que el campo del empleado). La gratificación se sigue derivando.
model SueldoMensual {
  id         String @id @default(cuid())
  empleadoId String
  year       Int
  month      Int // 1..12

  sueldoBase Int // base + bono imponible de ese mes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@unique([empleadoId, year, month])
  @@index([empleadoId])
}

// Indicadores económicos de un mes (período tributario). UF y UTM se traen
// automáticamente de internet (mindicador.cl); los dos topes cambian ~una vez
// al año y se editan a mano (arrastrando el último valor conocido).
model IndicadorMensual {
  id    String @id @default(cuid())
  year  Int
  month Int // 1..12

  uf  Float // valor UF usado por la liquidación del mes
  utm Float // valor UTM del mes (pesos)

  // 4,75 ingresos mínimos / 12 — tope de la gratificación legal mensual.
  gratificacionTopeMensual Int
  // Tope imponible (en UF) sobre el que se calcula el 7% deducible de la
  // base del impuesto único. Calibrado contra liquidación real.
  topeImponibleSaludUF Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}
